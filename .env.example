# Copy to .env.local (git-ignored) and fill in ONE key, or none.
# With no key, Byte answers in clearly labelled offline mode from curated, verified notes.

# Option A: Google Gemini (has a free tier with rate limits; check Google AI Studio's current terms)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# Option B: Anthropic Claude
ANTHROPIC_API_KEY=
# BYTE_MODEL=claude-opus-5-5   # e.g. claude-haiku-5-5 is far cheaper for short answers

# Force a provider when both keys are set: anthropic | gemini | offline
# BYTE_PROVIDER=

# Spending guard: max model-backed answers per server instance per day (default 300)
# BYTE_DAILY_LIMIT=300
# Per-visitor requests per 10 minutes (default 12)
# BYTE_RATE_LIMIT=12

# Public URL, used for canonical links, sitemap and Open Graph
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
